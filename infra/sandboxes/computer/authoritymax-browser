#!/bin/sh
set -eu
AUTHORITYMAX_HOME="${HOME:-/home/authoritymax}"
PROFILE="${AUTHORITYMAX_BROWSER_PROFILE:-$AUTHORITYMAX_HOME/.browser-profiles/chromium}"
BIN=""
for candidate in google-chrome-stable google-chrome chromium chromium-browser; do
  if BIN="$(command -v "$candidate" 2>/dev/null)"; then break; fi
  BIN=""
done
if [ -z "$BIN" ]; then
  echo "no browser is installed (expected google-chrome-stable or chromium)" >&2
  exit 1
fi
set -- "$BIN" \
  --test-type \
  --no-sandbox \
  --disable-dev-shm-usage \
  --ozone-platform=x11 \
  --enable-unsafe-swiftshader \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble --hide-crash-restore-bubble \
  --password-store=basic \
  --user-data-dir="$PROFILE" \
  --start-maximized \
  "$@"
# The supervisor pins the egress country's language; --lang also seeds Accept-Language.
if [ -n "${AUTHORITYMAX_BROWSER_LANG:-}" ]; then
  set -- "$@" "--lang=$AUTHORITYMAX_BROWSER_LANG"
fi
mkdir -p "$PROFILE"
# A previous container can leave the singleton files behind; they name a hostname that no
# longer exists, so Chrome would refuse the profile. Clear them only when no other process
# holds the profile (a live Chrome, or a launch still starting), else two Chromes would share
# it. `pgrep -f` also matches this shell's own command line, hence the `$$` skip.
held=0
for p in $(pgrep -f -- "--user-data-dir=$PROFILE( |\$)" 2>/dev/null); do
  if [ "$p" != "$$" ]; then held=1; break; fi
done
if [ "$held" -eq 0 ]; then
  rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonCookie" "$PROFILE/SingletonSocket"
fi
# Print mode is a dry run for tests and callers that only need the argv: no browser starts.
if [ "${AUTHORITYMAX_BROWSER_PRINT:-}" = "1" ]; then
  for arg in "$@"; do printf '%s\n' "$arg"; done
  exit 0
fi
exec "$@"
