#!/bin/sh
# Keeps a browser window on one display. A closed window ends the browser
# process, so this relaunches it a second later, until the display's stop file
# appears (screen teardown writes it before killing this loop).
# Usage: authoritymax-browser-keep <display> [browser args...]
set -u
if [ "$#" -lt 1 ]; then
  echo "usage: authoritymax-browser-keep <display> [browser args...]" >&2
  exit 2
fi
DISPLAY_NAME="$1"
shift
ROOT="${AUTHORITYMAX_KEEP_ROOT:-/tmp/authoritymax/screens}"
STOP="$ROOT/${DISPLAY_NAME#:}.stop"
mkdir -p "$ROOT"
rm -f "$STOP"
while [ ! -e "$STOP" ]; do
  DISPLAY="$DISPLAY_NAME" authoritymax-browser "$@"
  [ -e "$STOP" ] && break
  sleep 1
done
