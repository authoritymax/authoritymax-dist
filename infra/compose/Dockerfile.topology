FROM node:22-bookworm

# Same as infra/compose/Dockerfile: pnpm baked in for the `node` user, no runtime download.
ENV COREPACK_HOME=/opt/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
COPY package.json ./
RUN corepack enable && corepack install && chmod -R a+rX /opt/corepack
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @authoritymax/db generate
RUN install -d -m 750 -o node -g node /data

ENV NODE_ENV=production
EXPOSE 3100 7091
USER node
CMD ["pnpm", "--filter", "@authoritymax/api", "start"]
