NODE_ENV=development
DATABASE_URL=postgres://authoritymax:authoritymax@127.0.0.1:5433/authoritymax
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
# Desktop and mobile clients default to the hosted service (https://bots.authoritymax.ai).
# The two settings below are documented here for reference only: nothing loads this file into
# Electron or Expo. Export them in the shell that launches the desktop app, or set them in the
# EAS build environment for mobile.
# Desktop (shell env): pins the Electron shell to this origin for one launch without changing saved setup.
# AUTHORITYMAX_WEB_URL=http://127.0.0.1:5173
# Mobile (EAS env): compile-time default API origin for a self-hosted or branded build (HTTPS in production).
# EXPO_PUBLIC_API_URL=https://app.example.com
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Optional separate service credential; defaults to BETTER_AUTH_SECRET when empty.
SANDBOX_SUPERVISOR_TOKEN=
# production Compose reads this value; use e2b or dedicated-host there
SANDBOX_PROVIDER=docker
# Optional Docker daemon socket. Defaults to /var/run/docker.sock (Unix) or
# //./pipe/docker_engine (Windows). Set for rootless Docker, Colima, or custom paths.
# DOCKER_HOST takes precedence over DOCKER_SOCKET when both are set.
# DOCKER_SOCKET=
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
BOX_API_KEY=
# Optional Box API base URL; defaults to https://ascii.dev/api/box/v1.
BOX_API_URL=
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
# Pause or stop computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
SANDBOX_COMMAND_TIMEOUT_MS=300000
# Run and sandbox time limits, in milliseconds; 0 disables a limit. Defaults shown.
# How long a model provider may take to answer with response headers.
# MODEL_RESPONSE_TIMEOUT_MS=90000
# Fail a turn when the model produces no activity for this long (tool calls hold the clock).
# RUN_IDLE_TIMEOUT_MS=600000
# Hard ceiling on one execution attempt of a run.
# RUN_MAX_DURATION_MS=7200000
# Supervisor control calls (files, input, stop, destroy).
# SANDBOX_REQUEST_TIMEOUT_MS=30000
# Provisioning a computer (image pull/build, container start, screen readiness).
# SANDBOX_PROVISION_TIMEOUT_MS=120000
# Screen calls (observe, screen mode); an action batch adds its waits and settle on top.
# SANDBOX_SCREEN_TIMEOUT_MS=20000
# Added to a command's own timeout for the exec round trip.
# SANDBOX_EXEC_GRACE_MS=15000
# One whole-workspace export or import (per-turn checkpoint, wake-up restore).
# SANDBOX_TRANSFER_TIMEOUT_MS=600000
# Optional per-turn tool-call fuse for the Pi agent runtime. Unset, empty, or 0
# means unlimited (default). Set a positive integer to soft-stop a turn that
# exceeds the budget and still emit a final assistant message.
MAX_TOOL_CALLS_PER_TURN=
OPENROUTER_API_KEY=
PI_DEFAULT_PROVIDER=openrouter
# Text-only by default. Computer use (screenshots via computer_observe / computer_act)
# needs a vision-capable model — one whose catalog entry lists image input modalities
# (e.g. openai/gpt-4o). Tests use COMPUTER_E2E_MODEL for that.
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
# Optional local OpenAI-compatible models. Leave blank to disable the provider.
AUTHORITYMAX_LOCAL_MODELS=
AUTHORITYMAX_LOCAL_MODELS_URL=http://127.0.0.1:11434/v1
AUTHORITYMAX_LOCAL_CONTEXT_WINDOW=32768
AUTHORITYMAX_LOCAL_MAX_TOKENS=4096
# Allow user-connected OpenAI-compatible endpoints on public hostnames (default: private/loopback only).
AUTHORITYMAX_OPENAI_COMPAT_ALLOW_PUBLIC=
E2B_API_KEY=
COMPOSIO_API_KEY=
# Optional. Comma-separated app slugs the Integrations screen may offer (case/separator-insensitive),
# on top of the apps enabled in the connector provider's project. Empty offers everything enabled.
INTEGRATIONS_ALLOWLIST=
# Optional alternative managed connector provider.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development
SUPERMEMORY_API_KEY=
# Optional. Defaults to https://api.supermemory.ai. Self-hosted: http://localhost:6767
SUPERMEMORY_API_URL=
# Account email (password reset). Leave EMAIL_PROVIDER empty to hide "Forgot password?".
# smtp needs SMTP_URL (smtp://user:pass@host:587); resend needs RESEND_API_KEY; console prints mail to the API log.
EMAIL_PROVIDER=
EMAIL_FROM=AuthorityMax <no-reply@example.com>
SMTP_URL=
# Voice mode and text-to-speech stay hidden in every client until this is 1.
VOICE_ENABLED=
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
# Optional. GET /health returns this as `revision` so you can confirm the deployed commit.
GIT_SHA=

# --- Compose production deployments ---
# Absolute path of this checkout as the Docker *daemon* sees it. Production Compose defaults to
# /srv/authoritymax on Linux; override it for any other host path so the updater bind mount resolves.
# Linux override: AUTHORITYMAX_DEPLOY_DIR=/opt/authoritymax
# Docker Desktop on Windows (C:\Users\you\authoritymax):
#   AUTHORITYMAX_DEPLOY_DIR=/run/desktop/mnt/host/c/Users/you/authoritymax
AUTHORITYMAX_DEPLOY_DIR=
# Published images (defaults match this repository). Tag `local` is built from the checkout.
AUTHORITYMAX_IMAGE=ghcr.io/authoritymax/authoritymax-dist/app
AUTHORITYMAX_IMAGE_TAG=local
AUTHORITYMAX_IMAGE_TAG_PREVIOUS=
AUTHORITYMAX_UPDATER_IMAGE=ghcr.io/authoritymax/authoritymax-dist/updater
AUTHORITYMAX_UPDATER_IMAGE_TAG=local
# Where the updater reads the newest stable release. Empty uses the published manifest; a fork
# publishing under its own namespace points this at its own releases/latest.json (https only).
# AUTHORITYMAX_RELEASE_MANIFEST_URL=
# Required only when starting the opt-in `updater` Compose profile; the sidecar refuses to start
# without it. Use a dedicated random value, not BETTER_AUTH_SECRET / SANDBOX_SUPERVISOR_TOKEN;
# ≥32 chars in production. Leave empty when the sidecar is disabled.
AUTHORITYMAX_UPDATER_URL=
AUTHORITYMAX_UPDATER_TOKEN=

# Optional default UI locale for the web SPA (en | de | ko). Overridden by
# localStorage key authoritymax.uiLocale when the user picks a language in Settings.
# VITE_DEFAULT_UI_LOCALE=en

# --- Dedicated hosts (one VPS per account) ---
# SANDBOX_PROVIDER is above; set it to dedicated-host to run every account's computers on its own VPS.
# The two must be set together: COMPUTE_HOST_PROVIDER is ignored (and no VPS is ordered) unless
# SANDBOX_PROVIDER=dedicated-host.
COMPUTE_HOST_PROVIDER=            # contabo | box | fake | empty (dedicated hosts disabled)
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
CONTABO_REGION=EU
CONTABO_PRODUCT_ID=               # product id of the 8 GB Cloud VPS tier (see docs/dedicated-hosts.md)
CONTABO_IMAGE_ID=                 # optional; defaults to the standard Debian 13 image
CONTABO_SSH_KEY_SECRET_IDS=       # optional comma-separated Contabo secret ids for operator SSH
# Box (ascii.dev) provider; see docs/box-hosts.md. BOX_API_KEY / BOX_API_URL above are shared
# with the SANDBOX_PROVIDER=box computer provider.
BOX_HOST_TEMPLATE=                # optional named snapshot from infra/box-host/build-template.sh; unset = base image
BOX_HOST_SIZE=default             # small | default | large
DEDICATED_HOST_WG_PUBLIC_KEY=     # printed by infra/dedicated-host/setup-control-plane.sh
DEDICATED_HOST_WG_ENDPOINT=       # control-plane-ip:51820
DEDICATED_HOST_TUNNEL_CIDR=10.77.0.0/16
# Required whenever BOX_API_KEY is set and dedicated hosts are enabled, even with COMPUTE_HOST_PROVIDER=contabo:
# the range check covers every provider with credentials present, and startup refuses without it.
DEDICATED_HOST_TUNNEL_CIDR_BOX=   # per-provider tunnel range override; required for box, e.g. 10.213.0.0/16 (must not overlap 10.77.0.0/16)
DEDICATED_HOST_PEER_DIR=          # default $DATA_DIR/wireguard/peers
DEDICATED_HOST_IMAGE_REPOSITORY=ghcr.io/authoritymax/authoritymax-dist
DEDICATED_HOST_IMAGE_TAG=edge
DEDICATED_HOST_ALLOW_SSH=0
DEDICATED_HOST_SSH_AUTHORIZED_KEYS= # optional comma-separated public keys installed on every host
DEDICATED_HOST_MAX_HOSTS=         # optional cap on provisioned hosts
DEDICATED_HOST_PROVISION_TIMEOUT_MS=1800000
DEDICATED_HOST_WAKE_TIMEOUT_MS=90000 # box only: how long a wake may take before the host resets to asleep
